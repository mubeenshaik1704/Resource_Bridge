# Resource Bridge — Backend Environment Variables
# Copy this file to .env and fill in your values.

# Server port (default: 8080)
PORT=8080

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/resource_bridge_db

# JWT secret for signing authentication tokens (use a long random string in production)
JWT_SECRET=resource_bridge_secure_jwt_secret_key_2026

# ── AI Decision-Support (Gemini) ─────────────────────────────────────────────
# Get a FREE Gemini API key at: https://aistudio.google.com/app/apikey
# The AI feature will be disabled if this key is missing or set to the placeholder.
# NEVER expose this key to the frontend — it is used server-side only.
AI_API_KEY=your_gemini_api_key_here
